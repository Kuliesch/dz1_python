# Copy to .env locally — never commit real secrets.

# Player model (OpenAI-compatible)
PLAYER_API_KEY=
PLAYER_API_BASE=https://api.openai.com/v1
PLAYER_MODEL=gpt-4o-mini
PLAYER_LEARN_ITERATIONS=25

# First pilot game — mock by default (option 3)
GAME_SLUG=lucky-baker
GAME_URL=mock://lucky-baker
PLAYER_USE_MOCK=1
# Live Stake (when network/browser can pass Cloudflare):
# PLAYER_USE_MOCK=0
# GAME_URL=https://stake.com/casino/games/jeellee-lucky-baker

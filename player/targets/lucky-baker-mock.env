# Local mock for Lucky Baker learn/record (option 3 — no Cloudflare/Stake).
# Usage:
#   set -a && source .env && source player/targets/lucky-baker-mock.env && set +a
#   DATA_ROOT=./.data PYTHONPATH=player/src python3 -m main learn --game "$GAME_SLUG" --url "$GAME_URL" --mode model

GAME_SLUG=lucky-baker
# Resolved by player entrypoint helper; keep as mock://lucky-baker for compose/local scripts
GAME_URL=mock://lucky-baker
PLAYER_LEARN_ITERATIONS=15
PLAYER_USE_MOCK=1

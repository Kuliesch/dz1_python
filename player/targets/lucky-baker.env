# First Blue Wave player target
# Usage:
#   set -a && source player/targets/lucky-baker.env && set +a
#   docker compose --profile play run --rm player \
#     python -m main learn --game "$GAME_SLUG" --url "$GAME_URL" --iterations 30
#
# Requires PLAYER_API_KEY in the environment (do not commit secrets).

GAME_SLUG=lucky-baker
GAME_URL=https://stake.com/casino/games/jeellee-lucky-baker
PLAYER_LEARN_ITERATIONS=30
